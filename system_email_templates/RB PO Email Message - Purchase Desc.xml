<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
<#assign isCustom = (transaction.custbody_rb_custom_production?string == "Yes")>

<link name="Helvetica" type="font" subtype="type1"
src="${nsfont.Helvetica}"
src-bold="${nsfont.Helvetica_Bold}"
src-italic="${nsfont.Helvetica_Oblique}"
src-bolditalic="${nsfont.Helvetica_BoldOblique}"
bytes="2" />
<style>
body {
font-family: Helvetica;
color: #000;
width: 880px;
overflow: scroll;
margin: 0 auto;
}

p {
margin: 5 0;
}

.indent {
padding-left: 20px;
}

.message p {
font-size: 11pt;
margin: 8 0;
}

.message p.bullet {
margin: 3 0;
padding-left: 20px;
}

th {
padding: 8px;
border-bottom: 1px solid black;
font-weight: bold;
}

td.cell {
padding: 8px;
}

td.cell-div {
padding: 8px;
border-left: 1px dashed black;
}
</style>
</head>
<body padding="0.5in 0.5in 0.5in 0.5in" size="Letter">

<!-- ============ LOGO ============ -->
<table class="header" style="width: 100%; font-size: 10pt;">
<tr>
<td align="center">
<a href="https://www.royalbag.com/">
<img
src="https://888714.app.netsuite.com/core/media/media.nl?id=85432&amp;c=888714&amp;h=vx45izYbE3z0ZLBovy-0uBxWOUM9oiZisXN0sQGbeqEUODZw" />
</a>
</td>
</tr>
</table>

<!-- ============ BANNER: headline left, PO # right ============ -->
<table
style="width: 100%; margin-top: 48px; padding-bottom: 12; border-bottom: 0.3px solid;">
<tr>
<td style="vertical-align: middle; width: auto; padding-left: 0; color:#3c763d">
<#if isCustom>
<p style="font-size: 16pt; font-weight: 500;">Custom Production Purchase Order</p>
<p style="font-size: 12pt; ">All correspondences should be sent to: <a href="mailto:custombags@royalbag.com" style="color:#3c763d;"><strong>custombags@royalbag.com</strong></a></p>
<#else>
<p style="font-size: 16pt; font-weight: 500;">Purchase Order</p>
<p style="font-size: 12pt; ">Please acknowledge this PO and send tracking once shipped.</p>
</#if>
</td>
<td style="width: auto; text-align: right;">
<p style=" font-size: 20pt; ">#${transaction.tranid}</p>
<p style="">PO date: ${transaction.trandate}</p>
<p style=""><strong>Vendor:</strong> ${transaction.entity}</p>
</td>
</tr>
</table>

<!-- ============ INSTRUCTIONS ============ -->
<table class="message" style="width: 100%; margin-top: 32px;">
<tr>
<td>
<#if isCustom>
<p>Please email confirmation of this PO.</p>
<p>Once production is complete, please advise:</p>
<p class="bullet">&#8226; Quantity produced</p>
<p class="bullet">&#8226; Carton weight</p>
<p class="bullet">&#8226; Carton count</p>
<p>If this will be shipping on a pallet, please ensure pallet count, dimensions and weight per pallet are provided as well.</p>
<#else>
<p>Please use the attached packing slip.</p>
<p>Please email acknowledgment and tracking info to <a href="mailto:purchasing@royalbag.com"><strong>purchasing@royalbag.com</strong></a>.</p>
</#if>
<#if entity.custentity_rb_po_email_note?has_content>
<p><strong>Note:</strong> ${entity.custentity_rb_po_email_note}</p>
</#if>
</td>
</tr>
</table>

<!-- ============ SHIPPING ============ -->
<table style="width: 100%; margin-top: 32px;">
<tr>
<td style="vertical-align: top; width: 40%;">
<strong>Ship to:</strong>
<p class="indent">${transaction.shipaddress}</p>
</td>
<td style="vertical-align: top; width: 30%;">
<strong>Ship via:</strong>
<p class="indent">${transaction.shipmethod}</p>
</td>
<td style="vertical-align: top; width: 30%;">
<strong>Shipping account #:</strong>
<p class="indent">${transaction.custbody_rb_shipping_acc}</p>
</td>
</tr>
</table>

<!-- ============ ITEMS ============ -->
<#if transaction.item?has_content>
<table
style="width: 100%; margin-top: 16px; border-collapse: separate; border-spacing: 0; border: 1px solid black;">
<thead>
<tr>
<th style="width: 8%; text-align: center;">Qty</th>
<th style="width: 14%; text-align: left;">SKU</th>
<#if isCustom>
<th style="width: 14%; text-align: left;">Quote #</th>
<th style="width: 32%; text-align: left;">Description</th>
<th style="width: 8%; text-align: center;">Ov/Un %</th>
<#else>
<th style="width: 14%; text-align: left;">Vendor SKU</th>
<th style="width: 32%; text-align: left;">Description</th>
<th style="width: 8%; text-align: center;">Unit</th>
</#if>
<th style="width: 11%; text-align: right;">Rate</th>
<th style="width: 13%; text-align: right;">Total</th>
</tr>
</thead>
<#list transaction.item as item>
<tr>
<td class="cell" style="text-align: center;"><span>${item.quantity}</span></td>
<td class="cell-div" style="text-align: left;"><span>${item.custcol_rb_itemsku}</span></td>
<#if isCustom>
<td class="cell-div" style="text-align: left;"><span>${item.custcol_rb_vendorquotenum}</span></td>
<td class="cell-div" style="text-align: left;">
<span>${item.description}</span>
<#if item.custcol_rb_itemartlink?has_content>
<span><br /><a href="${item.custcol_rb_itemartlink}">View artwork</a></span>
</#if>
</td>
<td class="cell-div" style="text-align: center;"><span>${item.custcol_rb_overunderpercentage}</span></td>
<#else>
<td class="cell-div" style="text-align: left;"><span>${item.vendorname}</span></td>
<td class="cell-div" style="text-align: left;"><span>${item.description}</span></td>
<td class="cell-div" style="text-align: center;"><span>${item.units}</span></td>
</#if>
<td class="cell-div" style="text-align: right;"><span>${item.rate}</span></td>
<td class="cell-div" style="text-align: right;"><span>${item.amount}</span></td>
</tr>
</#list>
</table>
</#if>

<!-- ============ TOTAL ============ -->
<table style="page-break-inside: avoid; width: 100%; margin-top: 16px;">
<tr style="line-height: 200%;">
<td style="width: 70%;"></td>
<td align="right" style="font-weight: bold; color: #333333;">${transaction.total@label}:</td>
<td align="right" style="font-weight: bold;">${transaction.total}</td>
</tr>
</table>

<!-- ============ FOOTER (in body so it sits at the bottom of the email) ============ -->
<table style="width: 100%; margin-top: 48px; border-top: 0.3px solid; padding-top: 12;">
<tr>
<td align="center" style="font-size: 9pt; color: #555555;">
<p><strong>Giant Plastic Industries</strong></p>
<p>718-686-1120 &#160;|&#160; <#if isCustom>custombags@royalbag.com<#else>purchasing@royalbag.com</#if></p>
</td>
</tr>
</table>

</body>
</pdf>