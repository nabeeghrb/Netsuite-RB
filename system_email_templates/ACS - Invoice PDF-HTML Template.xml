<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<#-- DBA flag: sourced from customer field custentity_show_dba_on_invoice via transaction body field custbody_show_dba_on_invoice -->
	<#assign dbaFlag = record.custbody_show_dba_on_invoice!false>
	<#assign showDba = (dbaFlag?is_boolean && dbaFlag) || (dbaFlag?is_string && (dbaFlag == "T" || dbaFlag == "Yes" || dbaFlag == "true"))>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            <table class="header" style="width: 100%;"><tr>
	<td rowspan="5" style="width:40%;">
		<#if companyInformation.logoUrl?length != 0><@filecabinet nstype="image" src="${companyInformation.logoUrl}" style="margin: 7px 7px 0px 7px;width:250px;height:70px;" /></#if>
		<#if showDba><p class="dba">dba of Giant Plastic Industries USA</p></#if>
	</td>
	<td rowspan="5" style="width:20%;border-left: 3px solid #c4c3c0;vertical-align: middle;padding-left:5px;">cs@royalbag.com<br />866-686-7401<br />www.royalbag.com</td>
	<td align="right" style="width:40%;"><span class="title">${record@title}</span></td>
	</tr>
	<tr>
	<td align="right"><span class="number">#${record.tranid}</span></td>
	</tr></table>
        </macro>
        <macro id="nlfooter">
            <table class="footer" style="width: 100%;"><tr>
	<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
	<td align="right"><pagenumber/> of <totalpages/></td>
	</tr></table>
        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 10pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 9pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0px;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0px;
            font-size: 8pt;
        }
        p.dba {
            margin: 3px 7px 0px 7px;
            padding: 0px;
            width: 250px;
            text-align: right;
            align: right;
            font-size: 8.5pt;
            font-style: italic;
            color: #666666;
            letter-spacing: 0.3px;
        }
        td.payhead {
            padding: 0px 0px 3px 0px;
            font-size: 8pt;
            font-weight: bold;
            color: #666666;
            letter-spacing: 0.8px;
            border-bottom: 1px solid #d3d3d3;
        }
        td.paybody {
            padding: 6px 0px 0px 0px;
            font-size: 9pt;
        }
        table.totals td {
            padding: 4px 6px;
        }
        td.totlabel {
            align: right;
            text-align: right;
        }
        td.totvalue {
            align: right;
            text-align: right;
            width: 42%;
        }
        td.totrule {
            border-top: 1px solid #c4c3c0;
            padding-top: 7px;
        }
        td.balancedue {
            background-color: #e3e3e3;
            font-weight: bold;
            font-size: 12pt;
            padding: 7px 6px;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 13pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 9pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0px;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
      span.verticalline {
        border-left: 6px solid green;
      }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="<#if showDba>12%<#else>10%</#if>" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%; margin-top: 10px;"></table>

<table class="body" style="width: 100%; margin-top: 10px;"><tr>
	<td class="addressheader" style="width:35%;"><b>${record.billaddress@label}</b></td>
	<td class="addressheader" style="width:35%;"><b>${record.shipaddress@label}</b></td>
	<td align="right" rowspan="4" style="width:30%;">PO #${record.otherrefnum}<br />Date: ${record.trandate}<br />Ship via:${record.shipmethod}</td>
	</tr>
	<tr>
	<td class="address" rowspan="4">${record.billaddress}</td>
	<td class="address" rowspan="4">${record.shipaddress}</td>
	</tr></table>
<#if record.item?has_content>

<table class="itemtable" style="width: 100%; margin-top: 30px;"><!-- start items --><#list record.item as item><#if item_index==0>
<thead>
	<tr>
	<th colspan="4">ID</th>
	<th colspan="9">Name</th>
	<th colspan="2">Unit</th>
	<th align="right" colspan="4">Unit Price</th>
	<th align="right" colspan="3">Qty</th>
	<th align="right" colspan="4">Price</th>
	</tr>
</thead>
</#if><tr>
	<td colspan="4">${item.item?keep_before(' ')}</td>
	<td colspan="9">${item.item?keep_after(' ')}</td>
	<td colspan="2">${item.units}</td>
	<td align="right" colspan="4">${item.rate}</td>
	<td align="right" colspan="3">${item.quantity}</td>
	<td align="right" colspan="4">${item.amount}</td>
	</tr>
	</#list><!-- end items --></table>

<hr /></#if>
<#-- ===== Totals ===== -->
<#assign acsTotalDue = record.amountremaining?replace("$", "")>
<#assign acsTotalDue = acsTotalDue?replace(".", "")>
<#assign discDigits = (record.discounttotal!"")?string?replace("[^0-9]", "", "r")>
<#assign paidDigits = (record.amountpaid!"")?string?replace("[^0-9]", "", "r")>
<#assign hasDiscount = discDigits?has_content && discDigits?number != 0>
<#assign hasPayment = paidDigits?has_content && paidDigits?number != 0>
<table class="total" style="width: 100%; margin-top: 10px;"><tr>
	<td style="width: 54%; padding: 0px;">&nbsp;</td>
	<#-- Right: totals -->
	<td style="width: 46%; vertical-align: top; padding: 0px;">
		<table class="totals" style="width: 100%;">
		<tr>
			<td class="totlabel">Subtotal</td>
			<td class="totvalue">${record.subtotal}</td>
		</tr>
		<#if hasDiscount>
		<tr>
			<td class="totlabel">Discount</td>
			<td class="totvalue">${record.discounttotal}</td>
		</tr>
		</#if>
		<tr>
			<td class="totlabel">Shipping</td>
			<td class="totvalue">${record.shippingcost}</td>
		</tr>
		<#if record.taxitem?contains('NY')>
		<tr>
			<td class="totlabel">NY Sales Tax</td>
			<td class="totvalue">${record.taxtotal}</td>
		</tr>
		</#if>
		<tr>
			<td class="totlabel totrule"><b>Invoice Total</b></td>
			<td class="totvalue totrule"><b>${record.total}</b></td>
		</tr>
		<tr>
			<td class="totlabel" style="font-size: 9pt;">Payments applied</td>
			<td class="totvalue"><#if hasPayment>-</#if>${record.amountpaid}</td>
		</tr>
		<tr>
			<td class="totlabel balancedue">Balance Due</td>
			<td class="totvalue balancedue">${record.amountremaining}</td>
		</tr>
		</table>
	</td>
</tr>
<#if record.custbody_rb_pay_method?has_content>
<tr>
	<#-- Payment details: starts where Balance Due ends -->
	<td style="width: 54%; vertical-align: top; padding: 0px 20px 0px 0px;">
	<#if record.custbody_rb_pay_method?has_content>
		<table style="width: 100%;">
		<tr><td class="payhead">PAYMENT DETAILS</td></tr>
		<#if record.custbody_rb_pay_method?has_content>
		<tr><td class="paybody">Paid by: ${record.custbody_rb_pay_method}</td></tr>
		</#if>
		</table>
	</#if>
	</td>
	<td style="width: 46%; padding: 0px;">&nbsp;</td>
</tr>
</#if></table>
<#if acsTotalDue = '000'>
  &nbsp;
<#else>
<br/><br/><br/>
<table style="width:100%"><tr><td align="center" style="font-size:12px;">
<b>Remittance information:</b><br/><br/>
Mail - Royal Bag Inc. 5501 New Utrecht Ave. Suite 501 Brooklyn NY 11219<br/><br/>
EFT - Routing: 021000021 Account 166176630. Please include Invoice# in payment reference and email remittance advice to billing@royalbag.com.
</td></tr></table>
</#if>
<br/><br/><br/><table style="width:100%"><tr><td align="center" style="font-size:16px;"><b>Thank you for your order. We appreciate your business!</b></td></tr></table>
</body>
</pdf>